# Plantilla de configuracion. NO subas el archivo real con valores.
# El instalador crea /etc/easy-vulnscanner.env a partir de esto.
#
# Generar el secreto:  openssl rand -hex 32
# La password debe tener al menos 12 caracteres (usar un generador o gestor de contraseñas).

VULNSCAN_SECRET=cambiar-por-hex-aleatorio-de-64-caracteres
VULNSCAN_USER=admin
VULNSCAN_PASS=cambiar-por-password-de-al-menos-12-caracteres
VULNSCAN_HOST=127.0.0.1
VULNSCAN_PORT=5000
VULNSCAN_DATA_DIR=/var/lib/easy-vulnscanner
